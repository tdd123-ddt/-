          <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.6 }}>{item.desc}</Text>
        </Box>
      ))}
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 28 }}>
      <Text style={{ fontSize: 14, color: '#718096' }}>医护洞察与温度指引引擎</Text>
